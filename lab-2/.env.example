# Учетные данные PostgreSQL для docker compose.
# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Без .env docker compose использует значения по умолчанию (mikhail),
# заданные в самом docker-compose.yml после :-.
# ВАЖНО: эти значения действуют только при СОЗДАНИИ новой базы
# (при первом docker compose up на пустом volume).
DATABASE_USERNAME=mikhail
DATABASE_PASSWORD=***